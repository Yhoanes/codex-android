# Codex for Android — APK signing configuration.
# Dedicated production release key lives outside the repository in
# ../.codex-keystore/keystore.env or ~/.config/codex-keystore/keystore.env (never committed).
# External contributors without keystore.env fall back to a local
# ~/.android/debug.keystore generated on demand in 09-sign.sh.

_SIGN_ENV="${SIGNING_ENV:-}"
if [ -z "$_SIGN_ENV" ] && [ -f "$(dirname "$PROJECT")/.codex-keystore/keystore.env" ]; then
    _SIGN_ENV="$(dirname "$PROJECT")/.codex-keystore/keystore.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.config/codex-keystore/keystore.env" ]; then
    _SIGN_ENV="$HOME/.config/codex-keystore/keystore.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.keys/codex-signing.env" ]; then
    _SIGN_ENV="$HOME/.keys/codex-signing.env"
fi

if [ -n "$_SIGN_ENV" ] && [ -f "$_SIGN_ENV" ]; then
    # shellcheck disable=SC1090
    . "$_SIGN_ENV"
    KEYSTORE="${KEYSTORE:-${CE_RELEASE_KEYSTORE:-}}"
    KEY_ALIAS="${KEY_ALIAS:-${CE_RELEASE_KEY_ALIAS:-}}"
    KEY_PASS="${KEY_PASS:-${CE_RELEASE_KEY_PASS:-}}"
    STORE_PASS="${STORE_PASS:-${CE_RELEASE_STORE_PASS:-}}"
fi

KEYSTORE="${KEYSTORE:-${HOME:-.}/.android/debug.keystore}"
KEY_ALIAS="${KEY_ALIAS:-androiddebugkey}"
KEY_PASS="${KEY_PASS:-android}"
STORE_PASS="${STORE_PASS:-android}"
unset _SIGN_ENV
