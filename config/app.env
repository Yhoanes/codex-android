# Codex for Android — application identity & SDK floor/ceiling.
# Consumed ONLY via build/tools/gen_android_config.py ->
#   res/values/gen.xml  +  com/ce/ide/BuildConfig.java
# and via build/lib/paths.sh for aapt --min-sdk-version / --target-sdk-version.
# Never hardcode these in AndroidManifest.xml or Java sources.
#
# NOTE: Both PKG (com.ce.ide) and PKG_DEV (com.ce.dev) are 10 ASCII bytes exact
# (matching len("com.termux") == 10), enabling zero-PRoot in-place ELF prefix
# rewriting across codex, node, dpkg, bash, rg, and Bionic shared libs.

PKG=com.ce.ide
PKG_DEV=com.ce.dev
APP_NAME=Codex
APP_NAME_DEV=Codex Dev
VERSION_CODE=265112002
VERSION_NAME=26.51120.1-r2
CORE_VERSION=26.51120.41243
PORT=45197
PORT_DEV=45198
OAUTH_SCHEME=codex

# TARGET_SDK=28 MUST stay <= 28 so Android 10-16+ allows execve() directly from
# getFilesDir()/runtime/bin/* and getFilesDir()/usr/bin/* without W^X SELinux blocks.
MIN_API=28
TARGET_SDK=28
