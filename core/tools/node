#!/system/bin/sh
case "$0" in
  */*) RBIN="${0%/*}" ;;
  *)   RBIN="." ;;
esac
RBIN="$(cd "$RBIN" && pwd)"
RT="${RBIN%/*}"
FILES_DIR="${RT%/*}"
unset LD_PRELOAD
export LD_LIBRARY_PATH="$RT/node-lib:$FILES_DIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -f "$FILES_DIR/usr/etc/tls/openssl.cnf" ]; then
  export OPENSSL_CONF="$FILES_DIR/usr/etc/tls/openssl.cnf"
else
  export OPENSSL_CONF="$RT/certs/openssl.cnf"
fi
export SSL_CERT_FILE="${SSL_CERT_FILE:-$RT/certs/ca-certificates.crt}"
export NODE_EXTRA_CA_CERTS="${NODE_EXTRA_CA_CERTS:-$RT/certs/ca-certificates.crt}"
exec "$RBIN/node.elf" "$@"
